# ==========================================
# VCrupto - Environment Configuration Template
# ==========================================
# Duplicate this file as .env and fill in your values
# from the Firebase Console (Project Settings > General > Your apps)

# Firebase Configuration (EXPO_PUBLIC_ prefix makes variables available in client Expo code)
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyYourFirebaseApiKeyHere
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456789

# Standard Node / Functions fallback variables
FIREBASE_API_KEY=AIzaSyYourFirebaseApiKeyHere
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef123456789

# Optional: Set to true if testing with local Firebase Emulator Suite
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=false

